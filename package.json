{
  "name": "diego-moreno-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Landing de marca personal de Diego Moreno — AI/ML Engineering y Data Science",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "build": "npm run typecheck && npm run build:client && npm run build:server && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173",
    "audit": "npm audit --omit=dev && npm audit"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@gsap/react": "2.1.2",
    "gsap": "3.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261118.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
