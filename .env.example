# ---- Build (públicas: terminan en el HTML, nunca pongas secretos aquí) ----
# URL canónica definitiva, sin barra final
SITE_URL=https://diegomorenom.com
# false = noindex (entorno de revisión). Cambiar a true solo en el lanzamiento autorizado.
ALLOW_INDEXING=false
# Endpoint del formulario. Por defecto la función incluida: /api/contact
VITE_CONTACT_ENDPOINT=/api/contact
# Clave PÚBLICA de Cloudflare Turnstile (opcional pero recomendado)
VITE_TURNSTILE_SITE_KEY=
# Verificación de propiedad (pega solo el código que te dan, no la etiqueta entera)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Analítica sin cookies (Cloudflare Web Analytics → token del beacon)
CF_WEB_ANALYTICS_TOKEN=
# Perfiles propios adicionales para sameAs y rel=me, separados por coma (GitHub, X, Medium…)
EXTRA_PROFILES=
TWITTER_HANDLE=
# Origen permitido del endpoint si está en otro dominio (para la CSP connect-src)
CONTACT_ORIGIN=

# ---- Servidor (secretos: configúralos en Cloudflare/Vercel, NUNCA en el repo) ----
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Website <contacto@tu-dominio>
TURNSTILE_SECRET_KEY=
ALLOWED_ORIGINS=https://diegomorenom.com
